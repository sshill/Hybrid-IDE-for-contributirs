# ==============================================================================
# Hybrid Agentic IDE: Шаблон змінних середовища та ключів API (.env.example)
# Шлях для розгортання: ~/.env або ./config/.env
# ==============================================================================

# 1. Google AI Studio (Gemini Pro / Flash)
# Отримайте безкоштовний ключ на: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Groq Cloud LPU Inference (Безкоштовний ліміт 14,400 RPD / 30 RPM)
# Моделі: openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.3-70b-versatile
# Отримайте безкоштовний ключ на: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. OpenRouter Free Tier (Резервний пул безкоштовних моделей :free)
# Отримайте ключ на: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ==============================================================================
# Інструкція з активації для Debian 13 / Ubuntu:
# cp .env.example ~/.env
# chmod 600 ~/.env
# nano ~/.env
# ==============================================================================
