index 0000000..1e87c29
--- /dev/null
+++ b/core/verify/audit_gate.py
@@ -0,0 +1,291 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Deterministic audit report and user-review primitives for Antigravity."""
+
+import hashlib
+import json
+import os
+import re
+import sys
+import tempfile
+import uuid
+from datetime import datetime, timezone
+
+sys.dont_write_bytecode = True
+
+AUDIT_PHASES = {"2.5", "4.2", "4.5"}
+AUDIT_VERDICTS = {"PASS", "CHANGES_REQUIRED", "FAIL"}
+
+
+def parse_audit_report(response: str) -> tuple[str, str]:
+    """Return a verdict only for an explicitly structured, substantive report."""
+    if not isinstance(response, str):
+        return "INVALID_REPORT", "Auditor returned no text."
+
+    verdicts = list(re.finditer(
+        r"(?m)^\s*AUDIT_VERDICT:\s*(PASS|CHANGES_REQUIRED|FAIL)\s*$",
+        response,
+    ))
+    reports = list(re.finditer(r"(?m)^\s*AUDIT_REPORT:\s*$", response))
+    if len(verdicts) != 1 or len(reports) != 1 or reports[0].end() >= len(response):
+        return "INVALID_REPORT", "Missing AUDIT_VERDICT or AUDIT_REPORT section."
+
+    verdict_match = verdicts[0]
+    report_match = reports[0]
+    if (
+        response[:report_match.start()].strip()
+        or report_match.start() >= verdict_match.start()
+        or response[verdict_match.end():].strip()
+    ):
+        return "INVALID_REPORT", "Report must start with AUDIT_REPORT and end with one AUDIT_VERDICT."
+
+    report = response[report_match.end():verdict_match.start()].strip()
+    if len(report) < 80:
+        return "INVALID_REPORT", "Audit report is too short to review."
+
+    verdict = verdict_match.group(1)
+    if verdict not in AUDIT_VERDICTS:
+        return "INVALID_REPORT", "Unsupported audit verdict."
+    return verdict, report
+
+
+def session_state_dir(session_id: str) -> str:
+    """Resolve an explicit Antigravity conversation ID to its isolated state dir."""
+    if not isinstance(session_id, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,128}", session_id):
+        raise ValueError("A valid Antigravity conversation ID is required for audit state.")
+    brain_root = os.path.realpath(os.path.expanduser("~/.gemini/antigravity/brain"))
+    session_dir = os.path.realpath(os.path.join(brain_root, session_id))
+    if os.path.commonpath((brain_root, session_dir)) != brain_root or session_dir == brain_root:
+        raise ValueError("Conversation ID resolves outside the Antigravity brain directory.")
+    return os.path.join(session_dir, ".system_generated")
+
+
+def audit_directory(session_id: str) -> str:
+    path = os.path.join(session_state_dir(session_id), "audits")
+    os.makedirs(path, mode=0o700, exist_ok=True)
+    os.chmod(path, 0o700)
+    return path
+
+
+def _atomic_json_write(path: str, payload: dict):
+    directory = os.path.dirname(path)
+    fd, temp_path = tempfile.mkstemp(prefix=".audit-", dir=directory)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            json.dump(payload, stream, ensure_ascii=False, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp_path, path)
+    except Exception:
+        try:
+            os.unlink(temp_path)
+        except OSError:
+            pass
+        raise
+
+
+def ensure_new_audit_payload(session_id: str, phase: str, request: str):
+    if phase not in AUDIT_PHASES:
+        raise ValueError(f"Unsupported audit phase: {phase}")
+    request_sha = hashlib.sha256(request.encode("utf-8")).hexdigest()
+    directory = audit_directory(session_id)
+    for name in os.listdir(directory):
+        if not name.endswith(".json"):
+            continue
+        try:
+            with open(os.path.join(directory, name), "r", encoding="utf-8") as stream:
+                existing = json.load(stream)
+        except (OSError, json.JSONDecodeError):
+            continue
+        if (
+            existing.get("phase") == phase
+            and existing.get("request_sha256") == request_sha
+            and existing.get("execution") == "COMPLETED"
+        ):
+            raise ValueError(
+                f"Unchanged audit payload already executed as {existing.get('audit_id')}; "
+                "revise the input or explicitly request a retry."
+            )
+
+
+def record_audit(
+    session_id: str,
+    phase: str,
+    request: str,
+    response: str,
+    auditor: str,
+    execution: str,
+    verdict: str,
+    audit_id: str = None,
+    subject_sha256: str = None,
+) -> dict:
+    if phase not in AUDIT_PHASES:
+        raise ValueError(f"Unsupported audit phase: {phase}")
+
+    directory = audit_directory(session_id)
+    request_sha = hashlib.sha256(request.encode("utf-8")).hexdigest()
+    ensure_new_audit_payload(session_id, phase, request)
+    audit_id = audit_id or uuid.uuid4().hex
+    receipt = {
+        "schema": "hybrid-ide-audit-receipt-v1",
+        "audit_id": audit_id,
+        "session_id": session_id,
+        "phase": phase,
+        "auditor": auditor,
+        "execution": execution,
+        "verdict": verdict,
+        "request_sha256": request_sha,
+        "subject_sha256": subject_sha256,
+        "response_sha256": hashlib.sha256(response.encode("utf-8")).hexdigest(),
+        "report": response,
+        "created_at": datetime.now(timezone.utc).isoformat(),
+    }
+    _atomic_json_write(os.path.join(directory, f"{audit_id}.json"), receipt)
+    _atomic_json_write(os.path.join(directory, "latest.json"), receipt)
+    return receipt
+
+
+def _user_request_text(content: str) -> str:
+    if not isinstance(content, str):
+        return ""
+    match = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content, re.DOTALL)
+    return match.group(1).strip() if match else content.strip()
+
+
+def transcript_confirms(
+    transcript_path: str,
+    audit_id: str,
+    action: str,
+) -> bool:
+    if action not in {
+        "APPROVE_PLAN", "PROCEED", "READY_FOR_DEPLOY",
+        "ALLOW_PLAN_REVISION", "ALLOW_FIXES", "REVIEW_FINDINGS", "RETRY",
+    }:
+        return False
+    if not transcript_path or not os.path.isfile(transcript_path):
+        return False
+
+    expected = f"AUDIT-REVIEWED {audit_id} {action}"
+    try:
+        with open(transcript_path, "r", encoding="utf-8", errors="replace") as stream:
+            for line in stream:
+                try:
+                    record = json.loads(line)
+                except json.JSONDecodeError:
+                    continue
+                if record.get("type") == "USER_INPUT" and record.get("source") == "USER_EXPLICIT":
+                    if _user_request_text(record.get("content", "")) == expected:
+                        return True
+    except OSError:
+        return False
+    return False
+
+
+def load_latest_audit(session_id: str, phase: str = None) -> dict:
+    directory = audit_directory(session_id)
+    if phase is None:
+        path = os.path.join(directory, "latest.json")
+    else:
+        receipts = []
+        for name in os.listdir(directory):
+            if not name.endswith(".json") or name == "latest.json":
+                continue
+            try:
+                with open(os.path.join(directory, name), "r", encoding="utf-8") as stream:
+                    receipt = json.load(stream)
+                if receipt.get("phase") == phase:
+                    receipts.append(receipt)
+            except (OSError, json.JSONDecodeError):
+                continue
+        receipts.sort(key=lambda item: item.get("created_at", ""))
+        return receipts[-1] if receipts else {}
+    try:
+        with open(path, "r", encoding="utf-8") as stream:
+            receipt = json.load(stream)
+        return receipt if isinstance(receipt, dict) else {}
+    except (OSError, json.JSONDecodeError):
+        return {}
+
+
+def session_transcript_path(session_id: str) -> str:
+    session_dir = os.path.dirname(session_state_dir(session_id))
+    candidates = (
+        os.path.join(session_dir, ".system_generated", "logs", "transcript.jsonl"),
+        os.path.join(session_dir, "transcript.jsonl"),
+    )
+    return next((path for path in candidates if os.path.isfile(path)), "")
+
+
+def approve_plan_from_user_feedback(session_id: str, audit_id: str) -> str:
+    receipt = load_latest_audit(session_id, "2.5")
+    if receipt.get("audit_id") != audit_id or receipt.get("phase") != "2.5":
+        raise ValueError("The latest audit receipt is not the requested Phase 2.5 run.")
+    if receipt.get("execution") != "COMPLETED" or receipt.get("verdict") != "PASS":
+        raise ValueError("Only a completed Phase 2.5 PASS report can approve a plan.")
+    if not transcript_confirms(session_transcript_path(session_id), audit_id, "APPROVE_PLAN"):
+        raise ValueError("No matching user Request Feedback approval was found in the session transcript.")
+
+    state_dir = session_state_dir(session_id)
+    plan_path = os.path.join(os.path.dirname(state_dir), "implementation_plan.md")
+    if not os.path.isfile(plan_path):
+        raise ValueError("The session implementation_plan.md was not found.")
+    with open(plan_path, "rb") as stream:
+        plan_sha = hashlib.sha256(stream.read()).hexdigest()
+    if receipt.get("subject_sha256") != plan_sha:
+        raise ValueError("The implementation plan changed after the audited payload.")
+
+    approval_path = os.path.join(state_dir, "approved_plan.sha256")
+    fd, temp_path = tempfile.mkstemp(prefix=".approved-plan-", dir=state_dir)
+    try:
+        with os.fdopen(fd, "w", encoding="ascii") as stream:
+            stream.write(plan_sha + "\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp_path, approval_path)
+    except Exception:
+        try:
+            os.unlink(temp_path)
+        except OSError:
+            pass
+        raise
+    return plan_sha
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser(description="Validate or inspect an audit report.")
+    parser.add_argument("--validate-report", help="Path to a text audit response.")
+    parser.add_argument("--approve-plan", action="store_true", help="Approve the exact Phase 2.5 plan after user feedback.")
+    parser.add_argument("--session-id", help="Antigravity conversation ID.")
+    parser.add_argument("--audit-id", help="Audit receipt ID to review.")
+    args = parser.parse_args()
+    if args.approve_plan:
+        if not (args.session_id and args.audit_id):
+            parser.error("--approve-plan requires --session-id and --audit-id")
+        try:
+            plan_sha = approve_plan_from_user_feedback(args.session_id, args.audit_id)
+        except (OSError, ValueError) as exc:
+            print(f"PLAN_APPROVAL: DENIED: {exc}", file=sys.stderr)
+            return 2
+        print(f"PLAN_APPROVAL: APPROVED sha256={plan_sha}")
+        return 0
+    if not args.validate_report:
+        parser.error("--validate-report is required")
+    try:
+        with open(args.validate_report, "r", encoding="utf-8") as stream:
+            verdict, report = parse_audit_report(stream.read())
+    except OSError as exc:
+        print(f"AUDIT_EXECUTION: ERROR: {exc}", file=sys.stderr)
+        return 2
+    print(f"AUDIT_VERDICT: {verdict}")
+    if verdict == "INVALID_REPORT":
+        print(report, file=sys.stderr)
+        return 2
+    return 0 if verdict == "PASS" else 1
+
+
+if __name__ == "__main__":
+    import sys
+    sys.exit(main())
