+    def test_plan_approval_requires_matching_pass_receipt_and_user_event(self):
+        brain_root = os.path.join(self.tmp.name, ".gemini", "antigravity", "brain")
+        session_dir = os.path.join(brain_root, self.session_id)
+        state_dir = os.path.join(session_dir, ".system_generated")
+        os.makedirs(state_dir)
+        plan_path = os.path.join(session_dir, "implementation_plan.md")
+        plan = b"Plan revision 1\n"
+        with open(plan_path, "wb") as stream:
+            stream.write(plan)
+        plan_sha = __import__("hashlib").sha256(plan).hexdigest()
+
+        record_audit(
+            self.session_id, "2.5", plan.decode(), self.report, "Claude Sonnet",
+            "COMPLETED", "PASS", audit_id="audit-002", subject_sha256=plan_sha,
+        )
+        record_audit(
+            self.session_id, "4.2", "plan plus context", self.report, "Claude Sonnet",
+            "COMPLETED", "PASS", audit_id="audit-003",
+        )
+        with self.assertRaisesRegex(ValueError, "No matching user"):
+            approve_plan_from_user_feedback(
+                self.session_id, "audit-002"
+            )
+        user_event = {
+            "type": "USER_INPUT",
+            "source": "USER_EXPLICIT",
+            "content": "<USER_REQUEST>AUDIT-REVIEWED audit-002 APPROVE_PLAN</USER_REQUEST>",
+        }
+        log_dir = os.path.join(state_dir, "logs")
+        os.makedirs(log_dir)
+        with open(os.path.join(log_dir, "transcript.jsonl"), "w", encoding="utf-8") as stream:
+            stream.write(json.dumps(user_event) + "\n")
+        self.assertEqual(
+            approve_plan_from_user_feedback(self.session_id, "audit-002"),
+            plan_sha,
+        )
+        with open(os.path.join(state_dir, "approved_plan.sha256"), encoding="ascii") as stream:
+            self.assertEqual(stream.read().strip(), plan_sha)
+
+        with open(plan_path, "ab") as stream:
+            stream.write(b"changed after review\n")
+        with open(plan_path, "rb") as stream:
+            changed_sha = hashlib.sha256(stream.read()).hexdigest()
+        with open(os.path.join(state_dir, "approved_plan.sha256"), encoding="ascii") as stream:
+            approved_sha = stream.read().strip()
+        self.assertNotEqual(changed_sha, approved_sha)
+
