+#!/usr/bin/env python3
+import hashlib
+import json
+import os
+import sys
+import tempfile
+import unittest
+
+sys.dont_write_bytecode = True
+
+from core.verify.audit_gate import (
+    approve_plan_from_user_feedback,
+    ensure_new_audit_payload,
+    parse_audit_report,
+    record_audit,
+    transcript_confirms,
+)
+
+
+class TestAuditGate(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.old_home = os.environ.get("HOME")
+        os.environ["HOME"] = self.tmp.name
+        self.session_id = "conversation-123"
+        self.report = (
+            "AUDIT_REPORT:\n"
+            "Summary: The plan addresses the requested work and its known risks.\n"
+            "Findings: No blocking issues found. Verification scope is stated and "
+            "the proposal remains limited to the approved files.\n"
+            "AUDIT_VERDICT: PASS"
+        )
+
+    def tearDown(self):
+        if self.old_home is None:
+            os.environ.pop("HOME", None)
+        else:
+            os.environ["HOME"] = self.old_home
+        self.tmp.cleanup()
+
+    def test_unstructured_or_short_model_output_is_not_a_verdict(self):
+        self.assertEqual(parse_audit_report("Hello, I can help.")[0], "INVALID_REPORT")
+        self.assertEqual(
+            parse_audit_report("AUDIT_VERDICT: PASS\nAUDIT_REPORT:\nLooks good.")[0],
+            "INVALID_REPORT",
+        )
+        self.assertEqual(
+            parse_audit_report(
+                "AUDIT_REPORT:\n" + ("Substantive audit content. " * 5)
+                + "\nAUDIT_VERDICT: PASS\nAUDIT_VERDICT: PASS"
+            )[0],
+            "INVALID_REPORT",
+        )
+        self.assertEqual(
+            parse_audit_report("Hello!\n" + self.report)[0],
+            "INVALID_REPORT",
+        )
+
+    def test_explicit_report_verdict_is_parsed(self):
+        verdict, report = parse_audit_report(self.report)
+        self.assertEqual(verdict, "PASS")
+        self.assertIn("Findings:", report)
+
+    def test_receipt_is_session_scoped_and_duplicate_payload_is_rejected(self):
